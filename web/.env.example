# Copy to .env.local and fill in. Every value is optional; unset = feature off.
# Only public, build-time values belong here. Never put secrets in VITE_* vars.

# Display ads (needs consent). Placeholders shown; use your own IDs.
VITE_ADS_ENABLED=false
VITE_AD_PROVIDER=sponsor            # sponsor | adsense
VITE_ADSENSE_CLIENT=                # ca-pub-0000000000000000
VITE_ADSENSE_SLOT_GRID=             # ad unit id (digits)
VITE_ADSENSE_SLOT_SIDEBAR=          # ad unit id (digits)
VITE_SPONSOR_NAME=
VITE_SPONSOR_URL=
VITE_SPONSOR_TEXT=

# Affiliate cards (list lives in src/monetization/affiliates.json)
VITE_AFFILIATES_ENABLED=false

# Tip jar: Ko-fi / Buy Me a Coffee / GitHub Sponsors URL
VITE_SUPPORT_URL=

# Pro waitlist: Formspree-style JSON endpoint and/or mailto fallback address
VITE_WAITLIST_ENDPOINT=             # https://formspree.io/f/xxxxxxxx
VITE_WAITLIST_EMAIL=

# Desktop license checkout (https only). Unset uses the Polar checkout in src/monetization/offer.ts.
# A valid https URL overrides it. Anything else is ignored.
VITE_CHECKOUT_URL=

# Live alerts: public Discord invite (https://discord.gg/...). Hidden while empty.
VITE_DISCORD_INVITE_URL=

# Analytics (privacy-friendly Plausible, loads only after consent)
VITE_ANALYTICS_PROVIDER=none        # none | plausible
VITE_PLAUSIBLE_DOMAIN=              # clipspike.com
VITE_PLAUSIBLE_SRC=                 # optional self-hosted script URL
