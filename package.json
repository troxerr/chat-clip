{
  "name": "clipspike",
  "version": "3.0.0",
  "private": true,
  "description": "Chat-driven Twitch highlights with 9:16 reframing and local, Dropbox, or Google Drive storage.",
  "scripts": {
    "start": "node background.cjs",
    "vod": "node vod.cjs",
    "test": "node tools/run-tests.js",
    "check": "node tools/check-syntax.js",
    "serve": "python3 -m http.server 8080 --directory dist",
    "build:mac": "zsh mac/build.sh",
    "dropbox:auth": "node tools/dropbox-auth.js",
    "google:auth": "node tools/google-auth.js",
    "usage:audit": "node tools/usage-audit.js",
    "monitor": "node tools/monitor.js",
    "test:monitor": "node tools/run-tests.js test/monitor.test.js test/monitor-capture.test.js",
    "kick:relay": "node tools/kick-relay.js",
    "test:kick": "node tools/run-tests.js test/kick.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
